rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidCompetitor(data, competitorId) {
      return data.keys().hasAll([
          'id',
          'name',
          'stars',
          'completedCount',
          'lastDailyChallengeDate',
          'ownerUid',
          'kind',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'name',
          'stars',
          'completedCount',
          'lastDailyChallengeDate',
          'ownerUid',
          'kind',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == competitorId
        && isValidId(data.id)
        && data.id.size() <= 64
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 32
        && data.stars is int
        && data.stars >= 0
        && data.stars <= 100000
        && data.completedCount is int
        && data.completedCount >= 0
        && data.completedCount <= 500
        && data.lastDailyChallengeDate is string
        && data.lastDailyChallengeDate.size() <= 10
        && data.lastDailyChallengeDate.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && data.kind is string
        && data.kind in ['primary', 'companion']
        && data.isPublic is bool
        && data.isPublic == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProgress(data, userId) {
      return data.keys().hasAll([
          'uid',
          'childName',
          'stars',
          'completedIds',
          'adhkarProgress',
          'dailyChallengeCompletedDate',
          'activeCompetitorId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'childName',
          'stars',
          'completedIds',
          'adhkarProgress',
          'dailyChallengeCompletedDate',
          'activeCompetitorId',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.childName is string
        && data.childName.size() <= 32
        && data.stars is int
        && data.stars >= 0
        && data.stars <= 100000
        && data.completedIds is list
        && data.completedIds.size() <= 200
        && (data.completedIds.size() == 0 || (data.completedIds[0] is string && data.completedIds[0].size() <= 64))
        && data.adhkarProgress is map
        && data.adhkarProgress.size() <= 20
        && data.dailyChallengeCompletedDate is string
        && data.dailyChallengeCompletedDate.size() <= 10
        && data.dailyChallengeCompletedDate.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
        && data.activeCompetitorId is string
        && isValidId(data.activeCompetitorId)
        && data.activeCompetitorId.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /competitors/{competitorId} {
      allow get: if isValidId(competitorId) && existing().isPublic == true;
      allow list: if resource.data.isPublic == true;

      allow create: if isVerifiedUser()
        && isValidId(competitorId)
        && isValidCompetitor(incoming(), competitorId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(competitorId)
        && isValidCompetitor(incoming(), competitorId)
        && existing().ownerUid == request.auth.uid
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().kind == existing().kind
        && incoming().isPublic == existing().isPublic
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'stars', 'completedCount', 'lastDailyChallengeDate', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
        );

      allow delete: if isVerifiedUser()
        && isValidId(competitorId)
        && existing().ownerUid == request.auth.uid
        && existing().kind == 'companion';
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isVerifiedUser() && resource.data.uid == request.auth.uid;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProgress(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProgress(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'childName',
          'stars',
          'completedIds',
          'adhkarProgress',
          'dailyChallengeCompletedDate',
          'activeCompetitorId',
          'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
